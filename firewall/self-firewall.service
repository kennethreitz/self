[Unit]
Description=Block public admin/Swarm ports (see docs/security.md)
After=docker.service network-online.target
Wants=network-online.target
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/self-firewall.sh

[Install]
WantedBy=multi-user.target docker.service
